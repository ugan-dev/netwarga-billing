rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NetWarga: link tagihan ?inv=... dibaca publik tanpa login,
    // dan script Apps Script membaca koleksi customers tanpa Auth.
    // Karena itu baca customers harus publik. Tulis dibatasi:
    // aplikasi admin menulis dari browser (tanpa Auth) jadi write
    // masih terbuka di versi ini — JANGAN simpan data sensitif lain
    // di project Firebase yang sama. Kunci dengan Firebase Auth
    // sebelum dipakai untuk pelanggan sungguhan.
    match /customers/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /expenses/{docId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

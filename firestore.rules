rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Data utama: terbuka, supaya link tagihan publik (?inv=...) dan
    // script cronjob (tanpa login) tetap bisa baca/tulis.
    match /customers/{docId} {
      allow read, write: if true;
    }
    match /ledger/{docId} {
      allow read, write: if true;
    }
    match /app_meta/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hanya akun admin (Google, email terverifikasi) yang boleh baca/tulis data.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "gagan.70700@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Pengaturan toko (nama, rekening, QRIS, aturan tagihan) boleh dibaca publik
    // karena dipakai halaman tagihan pelanggan. Hanya admin yang bisa mengubah.
    match /app_meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Halaman tagihan pelanggan: dokumen diambil lewat token acak (get),
    // TIDAK boleh di-list supaya tidak bisa dicari satu per satu.
    match /invoices/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /customers/{docId} {
      allow read, write: if isAdmin();
    }

    match /ledger/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

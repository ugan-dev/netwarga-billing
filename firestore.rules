rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Data utama: tetap terbuka seperti sebelumnya, supaya link tagihan
    // lama dan script cronjob (tanpa login) tetap bisa baca.
    match /customers/{docId} {
      allow read, write: if true;
    }
    match /ledger/{docId} {
      allow read, write: if true;
    }
    match /app_meta/{docId} {
      allow read, write: if true;
    }

    // v5: dokumen tagihan publik, dibaca lewat token acak (?inv=...).
    // Baca publik, tapi tidak boleh di-list; tulis hanya saat login.
    match /invoices/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
